<Window x:Class="Arca.NET.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Arca.NET"
        xmlns:models="clr-namespace:Arca.NET.Models"
        mc:Ignorable="d"
        Title="Arca - Vault Manager"
        Height="760" Width="1200"
        MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a2e">

    <Window.Resources>
        <local:BoolToStatusConverter x:Key="BoolToStatusConverter"/>

        <!-- TextBox Style -->
                <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#16213e"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="CaretBrush" Value="#e94560"/>
            <Setter Property="BorderBrush" Value="#0f3460"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="2" VerticalAlignment="Center"/>
                                <TextBlock x:Name="WatermarkText"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="#64748b"
                                           FontSize="{TemplateBinding FontSize}"
                                           Margin="10,0,10,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4ecdc4"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Text" Value=""/>
                                    <Condition Property="IsFocused" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="WatermarkText" Property="Visibility" Value="Visible"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallTextBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>

        <!-- ComboBox Toggle Button Template -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="5" Background="#16213e" BorderBrush="#0f3460" BorderThickness="1.5" />
                <Border Grid.Column="0" CornerRadius="5,0,0,5" Margin="1" Background="#16213e" />
                <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 5 5 L 10 0 Z" Fill="#4ecdc4" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#4ecdc4" />
                    <Setter TargetName="Arrow" Property="Fill" Value="#e94560" />
                </Trigger>
                <Trigger Property="IsChecked" Value="true">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#e94560" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="ComboBoxTextBox" TargetType="TextBox">
            <Border x:Name="Border" Background="Transparent" Focusable="False">
                <ScrollViewer x:Name="PART_ContentHost" Margin="2" VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>

        <!-- Dark Mode ComboBox Style -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="true"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" 
                                          Template="{StaticResource ComboBoxToggleButton}" 
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False"  
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,3,32,3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#ffffff"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <TextBox x:Name="PART_EditableTextBox"
                                     Style="{x:Null}" 
                                     Template="{StaticResource ComboBoxTextBox}" 
                                     HorizontalAlignment="Left" 
                                     VerticalAlignment="Center" 
                                     Margin="12,3,32,3"
                                     Focusable="True" 
                                     Background="Transparent"
                                     Foreground="#ffffff"
                                     CaretBrush="#e94560"
                                     FontSize="13"
                                     Visibility="Hidden"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"/>
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" 
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"                
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#16213e"
                                            BorderThickness="1.5"
                                            BorderBrush="#0f3460"
                                            CornerRadius="6"
                                            Padding="4"
                                            Margin="0,4,0,0">
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="60"/>
                            </Trigger>
                            <Trigger Property="IsGrouping" Value="true">
                                <Setter Property="ScrollViewer.CanContentScroll" Value="false"/>
                            </Trigger>
                            <Trigger Property="IsEditable" Value="true">
                                <Setter Property="IsTabStop" Value="false"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#e8e8e8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#0f3460"/>
                                <Setter Property="Foreground" Value="#4ecdc4"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#0f3460"/>
                                <Setter Property="Foreground" Value="#e94560"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

                <!-- Button Styles -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#e94560"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#ff6b6b"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0f3460"/>
            <Setter Property="Foreground" Value="#4ecdc4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1f4b82"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="#16213e"/>
            <Setter Property="Foreground" Value="#f1f5f9"/>
            <Setter Property="BorderBrush" Value="#223354"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1f3b64"/>
                    <Setter Property="BorderBrush" Value="#4ecdc4"/>
                    <Setter Property="Foreground" Value="#ffffff"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#e2e8f0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1e293b"/>
                    <Setter Property="Foreground" Value="#4ecdc4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardActionButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#d0d8e8"/>
        </Style>

        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Background" Value="#2a2a4e"/>
            <Setter Property="Foreground" Value="#4ecdc4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0f3460"/>
                    <Setter Property="Foreground" Value="#ffffff"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#16213e" Padding="20,14" BorderBrush="#0f3460" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔐" FontSize="24" VerticalAlignment="Center"/>
                    <TextBlock Text="ARCA" FontSize="22" FontWeight="Bold" Foreground="#e94560"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Vault Manager" FontSize="13" Foreground="#8e9bb0"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <Border Background="#2a2a4e" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="txtHeaderVersion" FontSize="11" Foreground="#4ecdc4" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="🔒 Bloquear" Style="{StaticResource IconButton}"
                            Click="LockButton_Click" ToolTip="Bloquear Baúl" Margin="5,0,0,0" FontSize="13" Foreground="#ff6b6b"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="#0f3460" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <TextBox x:Name="txtSearch"
                         Style="{StaticResource ModernTextBox}"
                         Tag="🔍 Buscar secretos por clave, valor, entorno o tag..."
                         Width="340"
                         HorizontalAlignment="Left"
                         TextChanged="SearchBox_TextChanged"/>

                                <!-- Export/Import Button -->
                <Button Grid.Column="1"
                        Content="📦 Backup"
                        Style="{StaticResource ToolbarButton}"
                        Click="BackupButton_Click"
                        ToolTip="Exportar o Importar baúl"/>

                <!-- Audit Log Button -->
                <Button Grid.Column="2"
                        Content="📋 Auditoría"
                        Style="{StaticResource ToolbarButton}"
                        Click="AuditLogButton_Click"
                        ToolTip="Ver registro de accesos"/>

                <!-- API Keys Button -->
                <Button Grid.Column="3"
                        Content="🔑 API Keys"
                        Style="{StaticResource ToolbarButton}"
                        Click="ApiKeysButton_Click"
                        ToolTip="Gestionar API Keys por Proyecto o Secreto"/>

                <!-- Add Button -->
                <Button Grid.Column="4"
                        Content="➕ Nuevo Secreto"
                        Style="{StaticResource PrimaryButton}"
                        Margin="10,0,0,0"
                        Click="AddSecretButton_Click"/>
            </Grid>
        </Border>

        <!-- Main Content Area: Sidebar (Carpetas) + Secrets View -->
        <Grid Grid.Row="2" Margin="15,12,15,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar: Folders / Projects Explorer -->
            <Border Grid.Column="0" Background="#16213e" CornerRadius="8" Padding="12" Margin="0,0,15,0" BorderBrush="#0f3460" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Sidebar Header -->
                    <Grid Grid.Row="0" Margin="4,2,4,10">
                        <TextBlock Text="PROYECTOS / CARPETAS" FontSize="11" FontWeight="Bold" Foreground="#8e9bb0" VerticalAlignment="Center"/>
                        <Button Content="➕" Style="{StaticResource IconButton}" Padding="6,2" FontSize="12" HorizontalAlignment="Right" ToolTip="Crear Nueva Carpeta / Proyecto" Click="AddFolderButton_Click"/>
                    </Grid>

                    <!-- Folder List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="lstFolders">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding BackgroundBrush}" 
                                            CornerRadius="6" Margin="0,0,0,4" Padding="10,8" 
                                            Cursor="Hand" MouseLeftButtonDown="FolderItem_Click"
                                            Tag="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Icon}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="{Binding FontWeight}" Foreground="{Binding ForegroundBrush}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="2" Background="{Binding BadgeBackgroundBrush}" CornerRadius="10" Padding="7,2" VerticalAlignment="Center" Margin="4,0,0,0">
                                                <TextBlock Text="{Binding Count}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding BadgeForegroundBrush}"/>
                                            </Border>
                                            <!-- Delete Folder Button (only on user custom folders) -->
                                            <Button Grid.Column="3" Content="✕" Style="{StaticResource IconButton}" 
                                                    Padding="4,2" FontSize="10" Margin="4,0,0,0" Foreground="#ff6b6b"
                                                    Visibility="{Binding DeleteVisibility}" ToolTip="Eliminar carpeta"
                                                    Click="DeleteFolderButton_Click" Tag="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right Column: Secrets in Selected Folder -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Folder Active Header & Info -->
                <Grid Grid.Row="0" Margin="2,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="txtActiveFolderTitle" Text="📁 Todos los secretos" FontSize="17" FontWeight="Bold" Foreground="#ffffff"/>
                        <TextBlock x:Name="txtActiveFolderSubtitle" Text="(0 secretos)" FontSize="12" Foreground="#8e9bb0" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Empty State Banner -->
                <Border x:Name="pnlEmptyFolderState" Grid.Row="1" Background="#16213e" CornerRadius="8" Padding="30" 
                        BorderBrush="#0f3460" BorderThickness="1" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📂" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Esta carpeta aún no tiene secretos" FontSize="16" FontWeight="Bold" Foreground="#e8e8e8" HorizontalAlignment="Center"/>
                        <TextBlock Text="Puedes agregar secretos directamente a este proyecto." FontSize="12" Foreground="#8e9bb0" HorizontalAlignment="Center" Margin="0,5,0,20"/>
                        <Button Content="➕ Agregar Secreto aquí" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Click="AddSecretToCurrentFolder_Click"/>
                    </StackPanel>
                </Border>

                <!-- Secrets Cards List -->
                <ScrollViewer x:Name="scrollSecretsList" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="lstSecrets">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#16213e" CornerRadius="8" Margin="0,0,0,10" Padding="15" BorderBrush="#0f3460" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <!-- Badges: Folder & Environment -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Border Background="#2a2a4e" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" Visibility="{Binding FolderVisibility}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🗂️ " FontSize="10"/>
                                                        <TextBlock Text="{Binding Folder}" FontSize="10" FontWeight="SemiBold" Foreground="#4ecdc4"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#0f3460" CornerRadius="4" Padding="6,2" Visibility="{Binding EnvironmentVisibility}">
                                                    <TextBlock Text="{Binding Environment}" FontSize="10" FontWeight="Bold" Foreground="#ffa502"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Key Name -->
                                            <TextBlock Text="{Binding Key}" FontSize="15" FontWeight="Bold" Foreground="#ffffff"/>

                                            <!-- Description -->
                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#8e9bb0" Margin="0,3,0,0" Visibility="{Binding DescriptionVisibility}" TextWrapping="Wrap"/>

                                            <!-- Secret Value (Masked/Unmasked) -->
                                            <Border Background="#0f3460" CornerRadius="4" Padding="8,5" Margin="0,8,0,0" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Valor: " Foreground="#888" FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DisplayValue}" Foreground="#2ed573" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Action Buttons with High Contrast -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="{Binding RevealIcon}" Style="{StaticResource CardActionButton}" Click="ToggleRevealSecretButton_Click" ToolTip="Mostrar/Ocultar valor" Tag="{Binding}"/>
                                            <Button Content="📋" Style="{StaticResource CardActionButton}" Click="CopyValueButton_Click" ToolTip="Copiar valor" Tag="{Binding Value}"/>
                                            <Button Content="📁" Style="{StaticResource CardActionButton}" Click="QuickMoveSecretButton_Click" ToolTip="Mover a otra carpeta" Tag="{Binding}"/>
                                            <Button Content="✏️" Style="{StaticResource CardActionButton}" Click="EditSecretButton_Click" ToolTip="Editar" Tag="{Binding}"/>
                                            <Button Content="🗑️" Style="{StaticResource CardActionButton}" Click="DeleteSecretButton_Click" ToolTip="Eliminar" Tag="{Binding Id}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#0f3460" Padding="15,8">
            <Grid>
                <TextBlock x:Name="txtStatus" Text="🔓 Baúl desbloqueado" Foreground="#4ecdc4" FontSize="12"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="txtStatusVersion" FontSize="11" Foreground="#888"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtSecretCount" Text="0 secretos" Foreground="#8e9bb0" FontSize="12"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Add/Edit Secret Dialog -->
        <Border x:Name="pnlDialog"
                Grid.RowSpan="4"
                Background="#CC000000"
                Visibility="Collapsed">
            <Border Background="#1a1a2e"
                    CornerRadius="8"
                    Width="520"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="25">
                <StackPanel>
                                        <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="txtDialogTitle"
                                   Text="Agregar Secreto"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="#e94560"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="✕"
                                Style="{StaticResource IconButton}"
                                Foreground="#94a3b8" FontSize="15" Padding="8,4"
                                VerticalAlignment="Center"
                                Click="CancelDialogButton_Click"
                                ToolTip="Cerrar (Esc)"/>
                    </Grid>

                    <!-- Folder Selection -->
                    <TextBlock Text="Carpeta / Proyecto (Opcional)" Foreground="#aaa" FontSize="12" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cmbSecretFolder"
                              IsEditable="True"
                              Style="{StaticResource ModernComboBox}"
                              Margin="0,0,0,12"/>

                    <!-- Key with Quick Templates -->
                    <TextBlock Text="Clave (Nombre del Secreto)" Foreground="#aaa" FontSize="12" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtSecretKey" Style="{StaticResource ModernTextBox}" Tag="Ej: ConnectionStrings:cadena, JwtSettings:SecretKey..."/>

                    <!-- Quick Templates -->
                    <WrapPanel Margin="0,6,0,12">
                        <TextBlock Text="Plantillas: " Foreground="#666" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,6"/>
                        <Button Content="ConnectionStrings:" Style="{StaticResource ChipButton}" Click="QuickTemplate_Click" Tag="ConnectionStrings:"/>
                        <Button Content="JwtSettings:" Style="{StaticResource ChipButton}" Click="QuickTemplate_Click" Tag="JwtSettings:"/>
                        <Button Content="Security:" Style="{StaticResource ChipButton}" Click="QuickTemplate_Click" Tag="Security:"/>
                        <Button Content="BridgeSap:" Style="{StaticResource ChipButton}" Click="QuickTemplate_Click" Tag="BridgeSap:"/>
                        <Button Content="MicrosoftAuth:" Style="{StaticResource ChipButton}" Click="QuickTemplate_Click" Tag="MicrosoftAuth:"/>
                    </WrapPanel>

                    <!-- Value with Generator -->
                    <Grid Margin="0,0,0,5">
                        <TextBlock Text="Valor del Secreto" Foreground="#aaa" FontSize="12" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="🎲 Password" Style="{StaticResource ChipButton}" Margin="0,0,4,0" Click="GeneratePassword_Click" ToolTip="Generar contraseña segura"/>
                            <Button Content="🔑 AES-256" Style="{StaticResource ChipButton}" Margin="0" Click="GenerateAesKey_Click" ToolTip="Generar llave AES Base64"/>
                        </StackPanel>
                    </Grid>
                    <TextBox x:Name="txtSecretValue" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12" Tag="Valor confidencial del secreto..."/>

                    <!-- Environment (Optional) -->
                    <TextBlock Text="Entorno (Opcional)" Foreground="#aaa" FontSize="12" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cmbSecretEnvironment" Style="{StaticResource ModernComboBox}" Margin="0,0,0,12">
                        <ComboBoxItem Content="(Sin entorno)" IsSelected="True"/>
                        <ComboBoxItem Content="Development"/>
                        <ComboBoxItem Content="QA"/>
                        <ComboBoxItem Content="Staging"/>
                        <ComboBoxItem Content="Production"/>
                    </ComboBox>

                    <!-- Description -->
                    <TextBlock Text="Descripción (Opcional)" Foreground="#aaa" FontSize="12" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtSecretDescription" Style="{StaticResource ModernTextBox}" Tag="Opcional: Breve nota o propósito..."/>

                    <TextBlock x:Name="txtDialogError"
                               Foreground="#ff6b6b" FontSize="12"
                               Margin="0,12,0,0"
                               Visibility="Collapsed"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Cancelar"
                                Style="{StaticResource IconButton}"
                                Padding="15,10"
                                Click="CancelDialogButton_Click"/>
                        <Button Content="💾 Guardar"
                                Style="{StaticResource PrimaryButton}"
                                Margin="10,0,0,0"
                                Click="SaveSecretButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Quick Move Secret Dialog -->
        <Border x:Name="pnlMoveDialog"
                Grid.RowSpan="4"
                Background="#CC000000"
                Visibility="Collapsed">
            <Border Background="#1a1a2e"
                    CornerRadius="8"
                    Width="440"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="25">
                <StackPanel>
                                        <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="📁 Mover Secreto a otra Carpeta"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="#4ecdc4"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="✕"
                                Style="{StaticResource IconButton}"
                                Foreground="#94a3b8" FontSize="15" Padding="8,4"
                                VerticalAlignment="Center"
                                Click="CancelMoveDialog_Click"
                                ToolTip="Cerrar (Esc)"/>
                    </Grid>

                    <TextBlock x:Name="txtMoveSecretName" Text="Secreto: ..." Foreground="#e8e8e8" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,15"/>

                    <TextBlock Text="Selecciona o escribe la nueva carpeta de destino:" Foreground="#aaa" FontSize="12" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cmbMoveTargetFolder"
                              IsEditable="True"
                              Style="{StaticResource ModernComboBox}"
                              Margin="0,0,0,15"/>

                    <Border Background="#0f3460" CornerRadius="4" Padding="10" Margin="0,0,0,15">
                        <TextBlock Text="ℹ️ Nota: Si este secreto tiene API Keys vinculadas, los permisos se actualizarán automáticamente a la nueva ruta." 
                                   Foreground="#8e9bb0" FontSize="11" TextWrapping="Wrap"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar"
                                Style="{StaticResource IconButton}"
                                Padding="12,8"
                                Click="CancelMoveDialog_Click"/>
                        <Button Content="Mover Secreto"
                                Style="{StaticResource PrimaryButton}"
                                Margin="10,0,0,0"
                                Click="ConfirmMoveSecret_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Add New Folder Dialog (Independent creation) -->
        <Border x:Name="pnlFolderDialog"
                Grid.RowSpan="4"
                Background="#CC000000"
                Visibility="Collapsed">
            <Border Background="#1a1a2e"
                    CornerRadius="8"
                    Width="420"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="25">
                <StackPanel>
                                        <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Nueva Carpeta / Proyecto"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="#e94560"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="✕"
                                Style="{StaticResource IconButton}"
                                Foreground="#94a3b8" FontSize="15" Padding="8,4"
                                VerticalAlignment="Center"
                                Click="CancelFolderDialog_Click"
                                ToolTip="Cerrar (Esc)"/>
                    </Grid>

                    <TextBlock Text="Nombre de la Carpeta o Proyecto:" Foreground="#aaa" FontSize="12" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtNewFolderName" Style="{StaticResource ModernTextBox}" Tag="Ej: Portal_Clientes, SAP_Integration..."/>

                    <TextBlock Text="Podrás añadir secretos a esta carpeta en cualquier momento." Foreground="#666" FontSize="11" Margin="0,6,0,0"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Cancelar"
                                Style="{StaticResource IconButton}"
                                Padding="12,8"
                                Click="CancelFolderDialog_Click"/>
                        <Button Content="Crear Carpeta"
                                Style="{StaticResource PrimaryButton}"
                                Margin="10,0,0,0"
                                Click="ConfirmAddFolder_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- API Keys Management Dialog -->
                <!-- API Keys Management Dialog -->
        <Border x:Name="pnlApiKeys"
                Grid.RowSpan="4"
                Background="#CC000000"
                Visibility="Collapsed">
            <Border Background="#1a1a2e"
                    CornerRadius="8"
                    Width="820"
                    MaxHeight="680"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="22"
                    BorderBrush="#2E3646"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header with Close Button -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Gestión de API Keys (SDK)"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="#e94560"/>
                            <TextBlock Text="Genera API Keys con alcance a Proyectos/Carpetas completas o secretos individuales para el SDK."
                                       Foreground="#8e9bb0" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕"
                                Style="{StaticResource IconButton}"
                                Foreground="#94a3b8" FontSize="16" Padding="8,4"
                                VerticalAlignment="Top"
                                Click="CloseApiKeysButton_Click"
                                ToolTip="Cerrar (Esc)"/>
                    </Grid>

                    <!-- Scrollable Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,6,0">
                            <!-- New Key Form -->
                            <Border Background="#16213e" CornerRadius="6" Padding="14" Margin="0,0,0,12" BorderBrush="#223354" BorderThickness="1">
                                <StackPanel>
                                    <!-- Name and Access Level -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: Name of the API Key -->
                                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                            <TextBlock Text="Nombre descriptivo de la API Key:" Foreground="#a0aec0" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBox x:Name="txtNewKeyName"
                                                     Style="{StaticResource ModernTextBox}"
                                                     Tag="Ej: PortalWeb-Produccion, BridgeSAP-Service..."/>
                                        </StackPanel>

                                        <!-- Right: Access Level Selection -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,6">
                                            <TextBlock Text="Nivel de Acceso:" Foreground="#a0aec0" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="rbFullAccess" Content="Acceso Total"
                                                             Foreground="#2ed573" IsChecked="True"
                                                             VerticalAlignment="Center" Margin="0,0,12,0"
                                                             GroupName="AccessLevel"
                                                             Checked="AccessLevel_Changed"/>
                                                <RadioButton x:Name="rbRestrictedAccess" Content="Restringido"
                                                             Foreground="#ffa502" VerticalAlignment="Center"
                                                             GroupName="AccessLevel"
                                                             Checked="AccessLevel_Changed"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Permissions Scope Selection (Tree View) -->
                                    <Border x:Name="pnlSecretsSelection" Visibility="Collapsed"
                                            Background="#0f3460" CornerRadius="6" Padding="12" Margin="0,10,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Header & Quick Action Buttons -->
                                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                                    <TextBlock Text="Árbol de Proyectos y Secretos a exponer:" FontWeight="Bold" Foreground="#4ecdc4" FontSize="12"/>
                                                    <TextBlock Text="Marca carpetas completas o secretos específicos." Foreground="#a0aec0" FontSize="10" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="✓ Todos"
                                                            Style="{StaticResource ToolbarButton}"
                                                            Padding="7,3" Margin="0,0,4,0" FontSize="11"
                                                            Click="SelectAllTreeSecrets_Click"
                                                            ToolTip="Marca todos los proyectos y secretos"/>
                                                    <Button Content="✕ Ninguno"
                                                            Style="{StaticResource ToolbarButton}"
                                                            Padding="7,3" Margin="0,0,4,0" FontSize="11"
                                                            Click="SelectNoTreeSecrets_Click"
                                                            ToolTip="Desmarca todas las selecciones"/>
                                                    <Button x:Name="btnToggleExpandTree" Content="↔ Expandir/Contraer"
                                                            Style="{StaticResource ToolbarButton}"
                                                            Padding="7,3" FontSize="11"
                                                            Click="ToggleExpandTree_Click"
                                                            ToolTip="Alternar expandir y contraer todas las carpetas"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Search / Filter Box -->
                                            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                                <TextBlock Text="🔍 Filtrar proyectos o secretos:" Foreground="#a0aec0" FontSize="11" Margin="0,0,0,3"/>
                                                <TextBox x:Name="txtSecretFilter"
                                                         Style="{StaticResource SmallTextBox}"
                                                         Tag="Escribe para filtrar (ej: SAP, ConnectionStrings, JWT)..."
                                                         TextChanged="SecretTreeFilter_TextChanged"/>
                                            </StackPanel>

                                            <!-- TreeView Container -->
                                            <Border Grid.Row="2" Background="#16213e" CornerRadius="6" BorderBrush="#2E3646" BorderThickness="1" MaxHeight="160">
                                                <TreeView x:Name="tvApiKeyPermissions"
                                                          Background="Transparent"
                                                          BorderThickness="0"
                                                          Padding="6"
                                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                    <TreeView.ItemContainerStyle>
                                                        <Style TargetType="TreeViewItem">
                                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                                            <Setter Property="Visibility" Value="{Binding Visibility}"/>
                                                            <Setter Property="Foreground" Value="#ffffff"/>
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="Padding" Value="2,3"/>
                                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="TreeViewItem">
                                                                        <Grid>
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="*"/>
                                                                            </Grid.RowDefinitions>
                                                                            <Border x:Name="Bd"
                                                                                    Background="{TemplateBinding Background}"
                                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                                    Padding="{TemplateBinding Padding}"
                                                                                    CornerRadius="4"
                                                                                    MinHeight="26">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="18"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <ToggleButton x:Name="Expander"
                                                                                                  ClickMode="Press"
                                                                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                                                                  Background="Transparent"
                                                                                                  BorderThickness="0"
                                                                                                  Foreground="#4ecdc4"
                                                                                                  Cursor="Hand"
                                                                                                  HorizontalAlignment="Center"
                                                                                                  VerticalAlignment="Center">
                                                                                        <ToggleButton.Style>
                                                                                            <Style TargetType="ToggleButton">
                                                                                                <Setter Property="Template">
                                                                                                    <Setter.Value>
                                                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                                                            <Border Background="Transparent" Width="16" Height="16">
                                                                                                                <Path x:Name="ExpandPath"
                                                                                                                      HorizontalAlignment="Center"
                                                                                                                      VerticalAlignment="Center"
                                                                                                                      Fill="#4ecdc4"
                                                                                                                      Data="M 0 0 L 4 4 L 0 8 Z"/>
                                                                                                            </Border>
                                                                                                            <ControlTemplate.Triggers>
                                                                                                                <Trigger Property="IsChecked" Value="True">
                                                                                                                    <Setter TargetName="ExpandPath" Property="Data" Value="M 0 0 L 8 0 L 4 4 Z"/>
                                                                                                                    <Setter TargetName="ExpandPath" Property="Fill" Value="#ffa502"/>
                                                                                                                </Trigger>
                                                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                                                    <Setter TargetName="ExpandPath" Property="Fill" Value="#e94560"/>
                                                                                                                </Trigger>
                                                                                                            </ControlTemplate.Triggers>
                                                                                                        </ControlTemplate>
                                                                                                    </Setter.Value>
                                                                                                </Setter>
                                                                                            </Style>
                                                                                        </ToggleButton.Style>
                                                                                    </ToggleButton>
                                                                                    <ContentPresenter Grid.Column="1"
                                                                                                      x:Name="PART_Header"
                                                                                                      ContentSource="Header"
                                                                                                      HorizontalAlignment="Left"
                                                                                                      VerticalAlignment="Center"/>
                                                                                </Grid>
                                                                            </Border>
                                                                            <ItemsPresenter Grid.Row="1" x:Name="ItemsHost" Margin="18,0,0,0"/>
                                                                        </Grid>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="HasItems" Value="false">
                                                                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsExpanded" Value="false">
                                                                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsMouseOver" Value="true">
                                                                                <Setter TargetName="Bd" Property="Background" Value="#1f2937"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </TreeView.ItemContainerStyle>
                                                    <TreeView.ItemTemplate>
                                                        <HierarchicalDataTemplate DataType="{x:Type models:ApiKeyTreeNode}" ItemsSource="{Binding Children}">
                                                            <StackPanel Orientation="Horizontal" Margin="2,1">
                                                                <CheckBox IsThreeState="True"
                                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                          VerticalAlignment="Center"
                                                                          Margin="0,0,6,0"/>
                                                                <TextBlock Text="{Binding Icon}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding DisplayText}" FontSize="12" Foreground="#f8fafc" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </HierarchicalDataTemplate>
                                                    </TreeView.ItemTemplate>
                                                </TreeView>
                                            </Border>

                                            <!-- ListKeys Permission Toggle -->
                                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                                                <CheckBox x:Name="chkCanList"
                                                          Content="Permitir listar secretos disponibles en el SDK (ListKeys)"
                                                          Foreground="#cbd5e1" FontSize="11" IsChecked="True"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Generate Button -->
                                    <Button Content="🔑 Generar API Key"
                                            Style="{StaticResource PrimaryButton}"
                                            Margin="0,10,0,0"
                                            HorizontalAlignment="Right"
                                            Click="GenerateApiKeyButton_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Existing Keys List -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="API Keys Existentes:" Foreground="#94a3b8" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="lstApiKeys">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#16213e" CornerRadius="6" Margin="0,0,0,6" Padding="10" BorderBrush="#223354" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                                           Foreground="#f8fafc" FontSize="13"/>
                                                                <TextBlock Text="{Binding Permissions.Level}"
                                                                           Foreground="#ffa502" FontSize="10" FontWeight="SemiBold"
                                                                           Margin="8,2,0,0" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <TextBlock Foreground="#94a3b8" FontSize="11" Margin="0,2,0,0">
                                                                <Run Text="Último uso: "/>
                                                                <Run Text="{Binding LastUsedAt, StringFormat='{}{0:MM/dd HH:mm}', TargetNullValue='Nunca'}"/>
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <Button Grid.Column="1"
                                                                Content="Ver"
                                                                Style="{StaticResource ToolbarButton}"
                                                                Padding="9,4" FontSize="11"
                                                                Tag="{Binding Id}"
                                                                Click="ViewApiKeyPermissions_Click"
                                                                ToolTip="Ver permisos"/>

                                                        <Button Grid.Column="2"
                                                                Content="Revocar"
                                                                Style="{StaticResource IconButton}"
                                                                Foreground="#ff6b6b"
                                                                Padding="8,4" FontSize="11" Margin="4,0,0,0"
                                                                Tag="{Binding Id}"
                                                                Click="DeleteApiKeyButton_Click"
                                                                ToolTip="Revocar esta API Key"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>

                            <!-- Generated Key Display -->
                            <Border x:Name="pnlGeneratedKey"
                                    Background="#0f3460" CornerRadius="6" Padding="12"
                                    Visibility="Collapsed" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="⚠️ ¡Copia esta API Key ahora! No se volverá a mostrar."
                                               Foreground="#ffaa00" FontWeight="Bold" FontSize="12"/>
                                    <TextBox x:Name="txtGeneratedKey"
                                             Style="{StaticResource ModernTextBox}"
                                             IsReadOnly="True"
                                             Margin="0,8,0,0"
                                             FontFamily="Consolas"/>
                                    <Button Content="Copiar al Portapapeles"
                                            Style="{StaticResource PrimaryButton}"
                                            Margin="0,8,0,0"
                                            Click="CopyApiKeyButton_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Footer -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                <Button Content="Cerrar"
                                        Style="{StaticResource ToolbarButton}"
                                        Padding="16,8"
                                        Click="CloseApiKeysButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>

        <!-- Audit Log Dialog -->
        <Border x:Name="pnlAuditLog"
                Grid.RowSpan="4"
                Background="#CC000000"
                Visibility="Collapsed">
            <Border Background="#1a1a2e"
                    CornerRadius="8"
                    Width="800"
                    MaxHeight="600"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="25">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                                        <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="📋 Registro de Auditoría"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="#e94560"/>
                            <TextBlock Text="Historial de solicitudes de acceso a secretos y sus resultados."
                                       Foreground="#8e9bb0" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕"
                                Style="{StaticResource IconButton}"
                                Foreground="#94a3b8" FontSize="15" Padding="8,4"
                                VerticalAlignment="Top"
                                Click="CloseAuditLogButton_Click"
                                ToolTip="Cerrar (Esc)"/>
                    </Grid>

                    <!-- Statistics -->
                    <Border Grid.Row="1" Background="#16213e" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock x:Name="txtTotalRequests" Text="0" FontSize="24" FontWeight="Bold"
                                           Foreground="#4ecdc4" HorizontalAlignment="Center"/>
                                <TextBlock Text="Total Solicitudes" Foreground="#888" FontSize="11"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock x:Name="txtSuccessRequests" Text="0" FontSize="24" FontWeight="Bold"
                                           Foreground="#2ed573" HorizontalAlignment="Center"/>
                                <TextBlock Text="Exitosas" Foreground="#888" FontSize="11"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock x:Name="txtFailedRequests" Text="0" FontSize="24" FontWeight="Bold"
                                           Foreground="#ff6b6b" HorizontalAlignment="Center"/>
                                <TextBlock Text="Fallidas" Foreground="#888" FontSize="11"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                <TextBlock x:Name="txtUniqueClients" Text="0" FontSize="24" FontWeight="Bold"
                                           Foreground="#ffa502" HorizontalAlignment="Center"/>
                                <TextBlock Text="API Keys Únicas" Foreground="#888" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Log List -->
                    <Border Grid.Row="2" Background="#16213e" CornerRadius="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="lstAuditLogs">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#2a2a4e" BorderThickness="0,0,0,1" Padding="12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Timestamp, StringFormat='{}{0:MM/dd HH:mm:ss}'}"
                                                           Foreground="#888" FontSize="11" FontFamily="Consolas"
                                                           VerticalAlignment="Center"/>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ApiKeyName}"
                                                           Foreground="#4ecdc4" FontSize="11"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Action}"
                                                           Foreground="#ffa502" FontSize="11" FontWeight="Bold"
                                                           VerticalAlignment="Center"/>

                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding SecretKey, TargetNullValue='-'}"
                                                           Foreground="#e8e8e8" FontSize="11"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding Success, Converter={StaticResource BoolToStatusConverter}}"
                                                           FontSize="11" FontWeight="Bold"
                                                           VerticalAlignment="Center"
                                                           Foreground="#FF8E8787"
                                                           HorizontalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Footer -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button Content="Actualizar"
                                Style="{StaticResource IconButton}"
                                Padding="15,10"
                                Click="RefreshAuditLogButton_Click"/>
                        <Button Content="Cerrar"
                                Style="{StaticResource IconButton}"
                                Padding="15,10"
                                Margin="10,0,0,0"
                                Click="CloseAuditLogButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- Backup Dialog (Export/Import) -->
        <Border x:Name="pnlBackup"
                Grid.RowSpan="4"
                Background="#CC000000"
                Visibility="Collapsed">
            <Border Background="#1a1a2e"
                    CornerRadius="8"
                    Width="500"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="25">
                <StackPanel>
                                        <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Copia de Seguridad y Restauración"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="#e94560" Margin="0,0,0,4"/>
                            <TextBlock Text="Exporta tu baúl cifrado o restaura secretos desde un archivo de respaldo."
                                       Foreground="#8e9bb0" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕"
                                Style="{StaticResource IconButton}"
                                Foreground="#94a3b8" FontSize="15" Padding="8,4"
                                VerticalAlignment="Top"
                                Click="CloseBackupButton_Click"
                                ToolTip="Cerrar (Esc)"/>
                    </Grid>

                    <!-- Export Section -->
                    <Border Background="#16213e" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Exportar Baúl" FontWeight="Bold" Foreground="#2ed573" FontSize="14" Margin="0,0,0,10"/>
                            <TextBlock Text="Crea un archivo de respaldo cifrado con Argon2id + AES-GCM."
                                       Foreground="#888" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <TextBlock Text="Contraseña de Respaldo:" Foreground="#888" FontSize="11" Margin="0,0,0,5"/>
                            <PasswordBox x:Name="txtExportPassword"
                                         Background="#0f3460" Foreground="#e8e8e8"
                                         BorderBrush="#0f3460" BorderThickness="2"
                                         Padding="8,6" FontSize="13"/>

                            <TextBlock Text="Confirmar Contraseña:" Foreground="#888" FontSize="11" Margin="0,10,0,5"/>
                            <PasswordBox x:Name="txtExportPasswordConfirm"
                                         Background="#0f3460" Foreground="#e8e8e8"
                                         BorderBrush="#0f3460" BorderThickness="2"
                                         Padding="8,6" FontSize="13"/>

                            <Button Content="📦 Exportar a Archivo"
                                    Style="{StaticResource PrimaryButton}"
                                    Background="#2ed573"
                                    Margin="0,15,0,0"
                                    Click="ExportVaultButton_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Import Section -->
                    <Border Background="#16213e" CornerRadius="6" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Importar Baúl" FontWeight="Bold" Foreground="#ffa502" FontSize="14" Margin="0,0,0,10"/>
                            <TextBlock Text="Restaura secretos desde un archivo de respaldo."
                                       Foreground="#888" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <TextBlock Text="Contraseña del Respaldo:" Foreground="#888" FontSize="11" Margin="0,0,0,5"/>
                            <PasswordBox x:Name="txtImportPassword"
                                         Background="#0f3460" Foreground="#e8e8e8"
                                         BorderBrush="#0f3460" BorderThickness="2"
                                         Padding="8,6" FontSize="13"/>

                            <CheckBox x:Name="chkOverwriteExisting"
                                      Content="Sobrescribir secretos existentes con el mismo nombre"
                                      Foreground="#888" FontSize="11" Margin="0,10,0,0"/>

                            <CheckBox x:Name="chkImportApiKeys"
                                      Content="Importar API Keys (se importarán inactivas)"
                                      Foreground="#888" FontSize="11" Margin="0,5,0,0" IsChecked="True"/>

                            <Button Content="📥 Importar desde Archivo"
                                    Style="{StaticResource PrimaryButton}"
                                    Background="#ffa502"
                                    Margin="0,15,0,0"
                                    Click="ImportVaultButton_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Close Button -->
                    <Button Content="Cerrar"
                            Style="{StaticResource IconButton}"
                            Padding="15,10"
                            HorizontalAlignment="Right"
                            Margin="0,15,0,0"
                            Click="CloseBackupButton_Click"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- Notifications Container -->
        <StackPanel x:Name="notificationsContainer"
                    Grid.RowSpan="4"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Margin="20"
                    IsHitTestVisible="True"/>

        <!-- Confirm Dialog Container -->
        <Grid x:Name="dialogContainer" Grid.RowSpan="4"/>
    </Grid>
</Window>