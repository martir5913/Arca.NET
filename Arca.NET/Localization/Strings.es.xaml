<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- Header & Navigation -->
    <system:String x:Key="App_Title">Arca - Vault Manager</system:String>
    <system:String x:Key="Header_Tagline">Vault Manager</system:String>
    <system:String x:Key="Btn_Settings">⚙️ Ajustes</system:String>
    <system:String x:Key="Btn_Lock">🔒 Bloquear</system:String>
    <system:String x:Key="Search_Placeholder">🔍 Buscar secretos por clave, valor, entorno o tag...</system:String>
    <system:String x:Key="Btn_Backup">📦 Backup</system:String>
    <system:String x:Key="Btn_Audit">📋 Auditoría</system:String>
    <system:String x:Key="Btn_ApiKeys">🔑 API Keys</system:String>
    <system:String x:Key="Btn_NewSecret">➕ Nuevo Secreto</system:String>

    <!-- Sidebar Explorer -->
    <system:String x:Key="Sidebar_Title">PROYECTOS / CARPETAS</system:String>
    <system:String x:Key="Sidebar_NewFolder_Tooltip">Crear nueva carpeta de proyecto</system:String>
    <system:String x:Key="Folder_All">Todos los secretos</system:String>
    <system:String x:Key="Folder_NoFolder">Sin carpeta / Raíz</system:String>
    <system:String x:Key="Folder_Delete_Tooltip">Eliminar carpeta</system:String>
    <system:String x:Key="Folder_Empty_Title">Esta carpeta aún no tiene secretos</system:String>
    <system:String x:Key="Folder_Empty_Subtitle">Puedes agregar secretos directamente a este proyecto.</system:String>
    <system:String x:Key="Btn_AddSecretHere">➕ Agregar Secreto aquí</system:String>

    <!-- Status Bar -->
    <system:String x:Key="Status_Unlocked">🔓 Baúl desbloqueado</system:String>
    <system:String x:Key="Status_ServerReady">Servidor SDK listo</system:String>
    <system:String x:Key="Status_SecretSingular">secreto</system:String>
    <system:String x:Key="Status_SecretPlural">secretos</system:String>
    <system:String x:Key="Status_VaultActive">Baúl activo - Servidor SDK listo</system:String>
    <system:String x:Key="Status_NoApiKeys">(Sin API Keys - Acceso libre)</system:String>

    <!-- Card Actions -->
    <system:String x:Key="Card_Action_Toggle">Ver/Ocultar valor</system:String>
    <system:String x:Key="Card_Action_Copy">Copiar valor</system:String>
    <system:String x:Key="Card_Action_Move">Mover secreto a otra carpeta</system:String>
    <system:String x:Key="Card_Action_Edit">Editar secreto</system:String>
    <system:String x:Key="Card_Action_Delete">Eliminar secreto</system:String>

    <!-- Add/Edit Secret Dialog -->
    <system:String x:Key="Dialog_AddSecret_Title">Agregar Secreto</system:String>
    <system:String x:Key="Dialog_EditSecret_Title">Editar Secreto</system:String>
    <system:String x:Key="Dialog_Folder_Label">Carpeta / Proyecto (Opcional)</system:String>
    <system:String x:Key="Dialog_Key_Label">Clave (Nombre del Secreto)</system:String>
    <system:String x:Key="Dialog_Key_Placeholder">Ej: ConnectionStrings:cadena, JwtSettings:SecretKey...</system:String>
    <system:String x:Key="Dialog_Templates_Label">Plantillas:</system:String>
    <system:String x:Key="Dialog_Value_Label">Valor del Secreto</system:String>
    <system:String x:Key="Dialog_Value_Placeholder">Valor confidencial del secreto...</system:String>
    <system:String x:Key="Dialog_GenPassword_Tooltip">Generar contraseña segura</system:String>
    <system:String x:Key="Dialog_GenAes_Tooltip">Generar llave AES-256 Base64</system:String>
    <system:String x:Key="Dialog_Environment_Label">Entorno (Opcional)</system:String>
    <system:String x:Key="Dialog_NoEnvironment">(Sin entorno)</system:String>
    <system:String x:Key="Dialog_Description_Label">Descripción (Opcional)</system:String>
    <system:String x:Key="Dialog_Description_Placeholder">Opcional: Breve nota o propósito...</system:String>
    <system:String x:Key="Btn_Cancel">Cancelar</system:String>
    <system:String x:Key="Btn_Save">💾 Guardar</system:String>
    <system:String x:Key="Btn_Close">Cerrar</system:String>

    <!-- Move Secret Dialog -->
    <system:String x:Key="Move_Title">📁 Mover Secreto a otra Carpeta</system:String>
    <system:String x:Key="Move_Prompt">Selecciona o escribe la nueva carpeta de destino:</system:String>
    <system:String x:Key="Btn_ConfirmMove">Mover Secreto</system:String>

    <!-- New Folder Dialog -->
    <system:String x:Key="Folder_Dialog_Title">Nueva Carpeta / Proyecto</system:String>
    <system:String x:Key="Folder_Dialog_Label">Nombre de la Carpeta o Proyecto:</system:String>
    <system:String x:Key="Folder_Dialog_Placeholder">Ej: Portal_Clientes, SAP_Integration...</system:String>
    <system:String x:Key="Folder_Dialog_Hint">Podrás añadir secretos a esta carpeta en cualquier momento.</system:String>
    <system:String x:Key="Btn_CreateFolder">Crear Carpeta</system:String>

    <!-- API Keys Dialog -->
    <system:String x:Key="ApiKeys_Title">Gestión de API Keys (SDK)</system:String>
    <system:String x:Key="ApiKeys_Subtitle">Genera API Keys con alcance a Proyectos/Carpetas completas o secretos individuales para el SDK.</system:String>
    <system:String x:Key="ApiKeys_Name_Label">Nombre descriptivo de la API Key:</system:String>
    <system:String x:Key="ApiKeys_Name_Placeholder">Ej: PortalWeb-Produccion, BridgeSAP-Service...</system:String>
    <system:String x:Key="ApiKeys_Access_Label">Nivel de Acceso:</system:String>
    <system:String x:Key="ApiKeys_Access_Full">Acceso Total</system:String>
    <system:String x:Key="ApiKeys_Access_Restricted">Restringido</system:String>
    <system:String x:Key="ApiKeys_Tree_Title">Árbol de Proyectos y Secretos a exponer:</system:String>
    <system:String x:Key="ApiKeys_Tree_Subtitle">Marca carpetas completas o secretos específicos.</system:String>
    <system:String x:Key="ApiKeys_Btn_SelectAll">✓ Todos</system:String>
    <system:String x:Key="ApiKeys_Btn_SelectNone">✕ Ninguno</system:String>
    <system:String x:Key="ApiKeys_Btn_ToggleExpand">↔ Expandir/Contraer</system:String>
    <system:String x:Key="ApiKeys_Filter_Label">🔍 Filtrar proyectos o secretos:</system:String>
    <system:String x:Key="ApiKeys_Filter_Placeholder">Escribe para filtrar (ej: SAP, ConnectionStrings, JWT)...</system:String>
    <system:String x:Key="ApiKeys_CanList">Permitir listar secretos disponibles en el SDK (ListKeys)</system:String>
    <system:String x:Key="Btn_GenerateApiKey">🔑 Generar API Key</system:String>
    <system:String x:Key="ApiKeys_Existing_Title">API Keys Existentes:</system:String>
    <system:String x:Key="ApiKeys_LastUsed">Último uso:</system:String>
    <system:String x:Key="ApiKeys_NeverUsed">Nunca</system:String>
    <system:String x:Key="ApiKeys_Btn_View">Ver</system:String>
    <system:String x:Key="ApiKeys_Btn_Revoke">Revocar</system:String>
    <system:String x:Key="ApiKeys_Copy_Warning">⚠️ ¡Copia esta API Key ahora! No se volverá a mostrar.</system:String>
    <system:String x:Key="Btn_CopyToClipboard">Copiar al Portapapeles</system:String>

    <!-- Audit Log Dialog -->
    <system:String x:Key="Audit_Title">📋 Registro de Auditoría</system:String>
    <system:String x:Key="Audit_Subtitle">Historial de solicitudes de acceso a secretos y sus resultados.</system:String>
    <system:String x:Key="Audit_Stat_Total">Total Solicitudes</system:String>
    <system:String x:Key="Audit_Stat_Success">Exitosas</system:String>
    <system:String x:Key="Audit_Stat_Failed">Fallidas</system:String>
    <system:String x:Key="Audit_Stat_Clients">API Keys Únicas</system:String>
    <system:String x:Key="Btn_ExportCsv">📥 Exportar CSV</system:String>
    <system:String x:Key="Btn_Refresh">🔄 Actualizar</system:String>

    <!-- Backup & Restore Dialog -->
    <system:String x:Key="Backup_Title">Copia de Seguridad y Restauración</system:String>
    <system:String x:Key="Backup_Subtitle">Exporta, restaura o administra respaldos automáticos de tus secretos.</system:String>
    <system:String x:Key="Backup_Auto_Title">🛡️ Auto-Backups Locales (Rotativos)</system:String>
    <system:String x:Key="Btn_OpenFolder">📂 Abrir Carpeta</system:String>
    <system:String x:Key="Btn_InstantBackup">⚡ Crear Respaldo Inmediato</system:String>
    <system:String x:Key="Backup_Export_Title">Exportar Baúl a Archivo Cifrado</system:String>
    <system:String x:Key="Backup_Export_Subtitle">Genera un archivo cifrado con Argon2id + AES-GCM portable a otros servidores.</system:String>
    <system:String x:Key="Backup_Password_Label">Contraseña de Respaldo:</system:String>
    <system:String x:Key="Backup_ConfirmPassword_Label">Confirmar Contraseña:</system:String>
    <system:String x:Key="Btn_ExportToFile">📦 Exportar a Archivo...</system:String>
    <system:String x:Key="Backup_Import_Title">Importar Secretos desde Archivo de Respaldo</system:String>
    <system:String x:Key="Backup_Import_Subtitle">Descifra y recupera secretos hacia el baúl actual.</system:String>
    <system:String x:Key="Backup_ImportPassword_Label">Contraseña del Respaldo:</system:String>
    <system:String x:Key="Backup_Overwrite_Option">Sobrescribir secretos existentes con la misma clave</system:String>
    <system:String x:Key="Backup_ImportApiKeys_Option">Importar API Keys (se registrarán inactivas por seguridad)</system:String>
    <system:String x:Key="Btn_ImportFromFile">📥 Importar desde Archivo...</system:String>

    <!-- Settings Dialog -->
    <system:String x:Key="Settings_Title">⚙️ Ajustes y Preferencias</system:String>
    <system:String x:Key="Settings_Subtitle">Configura el idioma, respaldos automáticos, ubicaciones y comportamiento general.</system:String>
    <system:String x:Key="Settings_Language_Section">🌐 Idioma / Language</system:String>
    <system:String x:Key="Settings_Language_Label">Idioma de la interfaz:</system:String>
    <system:String x:Key="Settings_AutoBackup_Section">🛡️ Respaldos Automáticos (Auto-Backups)</system:String>
    <system:String x:Key="Settings_AutoBackup_Enable">Habilitar respaldos automáticos en segundo plano</system:String>
    <system:String x:Key="Settings_AutoBackup_Interval">Frecuencia de Respaldo:</system:String>
    <system:String x:Key="Settings_AutoBackup_Snapshots">Instantáneas a conservar:</system:String>
    <system:String x:Key="Settings_AutoBackup_Folder">Carpeta de Almacenamiento de Respaldos:</system:String>
    <system:String x:Key="Settings_Export_Section">📦 Exportación de Baúl (.arcavault)</system:String>
    <system:String x:Key="Settings_Export_Folder">Carpeta predeterminada para guardar exportaciones:</system:String>
    <system:String x:Key="Settings_Behavior_Section">🖥️ Comportamiento del Sistema</system:String>
    <system:String x:Key="Settings_MinimizeTray">Minimizar a la bandeja del sistema (System Tray) al cerrar</system:String>
    <system:String x:Key="Settings_AuditLog">Habilitar registro y monitoreo de auditoría en tiempo real</system:String>
    <system:String x:Key="Btn_Browse">📁 Examinar...</system:String>
    <system:String x:Key="Btn_SaveSettings">💾 Guardar Ajustes</system:String>

    <!-- About Dialog -->
    <system:String x:Key="Btn_About">ℹ️ Acerca de</system:String>
    <system:String x:Key="About_Title">Acerca de Arca.NET</system:String>
    <system:String x:Key="About_Subtitle">Gestor de secretos seguro, moderno y local para el ecosistema .NET.</system:String>
    <system:String x:Key="About_Security_Title">Arquitectura y Seguridad</system:String>
    <system:String x:Key="About_Security_Desc">Cifrado de grado militar con Argon2id + AES-256-GCM. Comunicación local inter-proceso con Named Pipes (&lt;1ms) en memoria, sin abrir puertos de red (100% Air-Gapped).</system:String>
    <system:String x:Key="About_Developer_Title">Desarrollador y Contacto</system:String>
    <system:String x:Key="About_Dev_Name">Ing. Fredy Martir</system:String>
    <system:String x:Key="About_Dev_Role">Desarrollador / Arquitecto de Software</system:String>
    <system:String x:Key="About_Dev_Email">martir.dev@gmail.com</system:String>
    <system:String x:Key="About_Dev_Repo">https://github.com/martir5913/Arca.NET</system:String>
    <system:String x:Key="About_Btn_OpenRepo">🌐 Ver Repositorio en GitHub</system:String>
    <system:String x:Key="About_Btn_CopyRepo">📋 Copiar Link</system:String>
    <system:String x:Key="About_Btn_SendEmail">✉️ Enviar Correo</system:String>

</ResourceDictionary>
